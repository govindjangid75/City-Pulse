# ==============================================================================
# CityPulse Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
PROJECT_NAME="CityPulse"
API_V1_STR=/api/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# Database Connection (SQLite local file by default)
DATABASE_URL="sqlite:///./citypulse.db"

# Active Monitored Metropolitan Zones
ACTIVE_ZONES=["zone-1", "zone-2", "zone-3", "zone-4"]

# Correlation Engine Tuning
ROLLING_WINDOW_MINUTES=30
CORRELATION_THRESHOLD_COUNT=3

# Feed Ingestion Polling Schedules (in seconds)
POLL_WEATHER_SECONDS=3600
POLL_TRANSIT_SECONDS=180
POLL_311_SECONDS=60

# LLM Narrative Generation (Optional)
USE_LLM_SUMMARY=false
LLM_PROVIDER=gemini
LLM_API_KEY=""

# Security & CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "*"]
